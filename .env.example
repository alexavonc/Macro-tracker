# Copy to .env and fill in. .env is git-ignored and never shipped to the browser.

# Server-side API keys — the server proxies AI calls so these never reach the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Access control: only these Google-account emails may sign in and use the app.
# Comma-separated, case-insensitive. Fail-closed — if this is empty, nobody gets in.
ALLOWED_EMAILS=you@example.com
